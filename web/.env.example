# Supabase (fase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Radice degli indirizzi del sito: serve al link di accesso dei direttori
# (Task 4) e al testo pronto per l'email ai soci (Task 8).
NEXT_PUBLIC_SITO_URL=

# Resend, per l'email che avvisa i direttori a ogni richiesta (fase 4).
#
# Finché mancano, il sito funziona lo stesso: le richieste si salvano e il
# socio riceve la conferma, ma nessuno viene avvisato — la colonna
# `email_inviata` resta falsa e l'elenco in area riservata lo mostrerà.
# Meglio che perdere la richiesta perché non parte una notifica.
RESEND_API_KEY=
# Uno o più indirizzi separati da virgola.
EMAIL_DIRETTORI=
# Il mittente. Va su un dominio verificato in Resend: finché cralares.it non
# è registrato si usa quello di prova di Resend, che però finisce nello spam.
EMAIL_MITTENTE=

# Cloudflare Turnstile, il controllo antispam dei moduli (fase 4).
#
# Finché mancano, il controllo è spento e i moduli funzionano come prima: il
# widget non compare e lo script di Cloudflare non viene nemmeno caricato,
# quindi il socio non manda una richiesta a un terzo per aprire una pagina
# del CRAL.
#
# Le chiavi sono gratuite: si creano su dash.cloudflare.com, sezione
# Turnstile, aggiungendo il dominio del sito. La prima finisce nel browser
# ed è pubblica, la seconda resta sul server e non va mai versionata.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
